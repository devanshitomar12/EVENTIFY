# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string, or set to 'memory' for embedded DB)
MONGO_URI=mongodb://127.0.0.1:27017/eventify_db

# JWT Authentication
JWT_SECRET=eventify_super_secret_jwt_key_2026_modern_event_booking_platform
JWT_EXPIRE=30d

# Cloudinary (Optional for cloud media uploads; falls back to data URI if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer / SMTP (Optional; falls back to Ethereal dev email/console preview)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL="Eventify" <no-reply@eventify.com>
