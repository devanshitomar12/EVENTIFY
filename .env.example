# Eventify Root Environment Reference
# Individual backend configuration is located in backend/.env

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/eventify_db
JWT_SECRET=eventify_super_secret_jwt_key_2026_modern_event_booking_platform
JWT_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP / Nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL="Eventify Team" <no-reply@eventify.com>
